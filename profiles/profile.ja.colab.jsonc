// ============================================================
// crisp-caption profile — Colab 遠端模式範例
// 這是 JSONC：// 或 /* ... */ 是註解，載入時自動忽略。
// ============================================================
{
  // --- 基本 ---
  "name": "Japanese Colab remote example",
  "description": "Remote ASR/translation via Colab tunnel. Copy to profile.ja.json and paste tunnel URLs.",
  "tags": ["live", "stable", "ja", "colab", "remote"],

  // bridge 伺服器監聽位置（瀏覽器 UI 連這個）
  "host": "127.0.0.1",
  "port": 8765,

  // --- ASR（語音辨識）---
  // 運算位置：remote = 連到遠端（Colab）跑 ASR
  "asr_mode": "remote",

  // 遠端 ASR 的 WebSocket 位址（Colab 的 /asr/stream）
  // 由控制面板 WebUI 的 Connect 設定填入（或手動貼上 tunnel URL）
  "remote_asr_url": "wss://YOUR-COLAB-TUNNEL.trycloudflare.com/asr/stream",

  // 連上面的位址時，從哪個環境變數讀 token
  "remote_asr_bearer_env": "CRISPASR_REMOTE_KEY",

  // CrispASR 執行檔路徑（遠端模式下本機未直接使用，保留）
  "crispasr": "tools/crispasr/crispasr.exe",

  // 直接透傳給遠端 CrispASR 的 CLI 參數
  // 注意：遠端模式路徑不以 ../ 開頭（在 Colab 根目錄解析）
  // 以下參數與本機 profile-stable-ja.jsonc 一致（T4 適用）
  "crisp_args": [
    "--backend", "cohere",
    "-l", "ja",
    "-m", "models/asr/cohere-asr-ja-q6_k.gguf",
    "--stream-json",
    "--stream-final-mode", "redecode",
    "--stream-utterance-max-sec", "10",
    "--stream-final-on-silence-ms", "500",
    "--stream-vad-merge-gap-ms", "0",
    "--stream-length", "7500",
    "--stream-step", "1500",
    "--stream-partial-decode-ms", "0",
    "--hotwords-file","hotwords.txt",
    "--vad",
    "-vm", "models/vad/firered-vad.gguf",
    "-vt", "0.50",
    "-vspd", "200",
    "-vsd", "200",
    "-vmsd", "10",
    "-vp", "100",
    "--beam-size", "3"
  ],

  // --- 翻譯 ---
  // 翻譯模型（對應遠端翻譯伺服器的模型 alias）
  "translate_model": "Hy-MT2-1.8B",

  // 遠端翻譯端點（Colab 的 /v1/chat/completions）
  "translate_url": "https://YOUR-COLAB-TUNNEL.trycloudflare.com/v1/chat/completions",

  // 用多少筆最近翻譯當上下文
  "translate_window": 6,

  // 翻譯抽樣參數
  "temperature": 0.0,
  "top_k": 20,
  "top_p": 0.95,
  "repeat_penalty": 1.05,
  "max_tokens": 2048,

  // 附加檔案（可選）
  "translate_prompt_file": "translate_prompt.txt",
  "glossary_file": "glossary.json"
}
