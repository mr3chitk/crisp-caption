// ============================================================
// crisp-caption profile — 本機 + Colab 通用（Stable JA）
// Steadier Japanese live subtitles for T4-class GPU:
//   stream-length 5000, stream-step 1000, partial-decode 1500.
// 這是 JSONC：// 或 /* ... */ 是註解，載入時自動忽略。
// ============================================================
{
  // --- 基本 ---
  "name": "Stable JA",
  "description": "Steadier JA live subtitles: length 5000, step 1000, partial 1500.",
  "tags": ["live", "stable", "ja"],

  // bridge 伺服器監聽位置（瀏覽器 UI 連這個）
  "host": "127.0.0.1",
  "port": 8765,

  // --- ASR（語音辨識）---
  "crispasr": "tools/crispasr/crispasr.exe",
  "crisp_args": [
    "--backend", "qwen3",
    "-l", "ja",
    "-m", "../models/asr/qwen3-asr-1.7b-q4_k.gguf",
    "--stream-json",
    "--stream-final-mode", "redecode",
    "--stream-utterance-max-sec", "30",
    "--stream-final-on-silence-ms", "500",
    "--stream-vad-merge-gap-ms", "0",
    "--stream-length", "7500",
    "--stream-step", "2000",
    "--stream-partial-decode-ms", "0",
    "--frequency-penalty", "0.2",
    "--hotwords-file","hotwords.txt",
    "--vad",
    "-vm", "../models/vad/firered-vad.gguf",
    "-vt", "0.50",
    "-vspd", "200",
    "-vsd", "500",
    "-vmsd", "30",
    "--seed", "1"
  ],

  // --- 翻譯 ---
  "translate_model": "Hy-MT2-1.8B",
  "translate_url": "http://127.0.0.1:8080/v1/chat/completions",
  "translate_window": 6,
  "temperature": 0.0,
  "top_k": 20,
  "top_p": 0.95,
  "repeat_penalty": 1.05,
  "max_tokens": 2048,
  "translate_prompt_file": "translate_prompt.txt",
  "glossary_file": ""
}
