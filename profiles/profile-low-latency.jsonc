// ============================================================
// crisp-caption profile — 本機模式（Low latency）
// Lowest-lag streaming：utterance 15s、step 500、partial 1000。
// 這是 JSONC：// 或 /* ... */ 是註解，載入時自動忽略。
// ============================================================
{
  // --- 基本 ---
  "name": "Low latency",
  "description": "Lowest-lag streaming",
  "tags": ["live", "low-latency"],

  // bridge 伺服器監聽位置（瀏覽器 UI 連這個）
  "host": "127.0.0.1",
  "port": 8765,

  // --- ASR（語音辨識）---
  "crispasr": "tools/crispasr/crispasr.exe",
  "crisp_args": [
    "--backend", "cohere",
    "-l", "ja",
    "-m", "../models/asr/cohere-asr-ja-q6_k.gguf",
    "--stream-json",
    "--stream-final-mode", "redecode",
    "--stream-utterance-max-sec", "10",
    "--stream-final-on-silence-ms", "500",
    "--stream-vad-merge-gap-ms", "0",
    "--stream-length", "7500",
    "--stream-step", "1500",
    "--stream-partial-decode-ms", "0",
    "--frequency-penalty", "0.2",
    "--hotwords-file","hotwords.txt",
    "--vad",
    "-vm", "../models/vad/firered-vad.gguf",
    "-vt", "0.50",
    "-vspd", "200",
    "-vsd", "200",
    "-vmsd", "10",
    "-vp", "100"
  ],

  // --- 翻譯 ---
  "translate_model": "Hy-MT2-1.8B",
  "translate_url": "http://127.0.0.1:8080/v1/chat/completions",
  "translate_window": 6,
  "temperature": 0.0,
  "top_k": 20,
  "top_p": 0.95,
  "repeat_penalty": 1.05,
  "max_tokens": 2048,
  "translate_prompt_file": "translate_prompt.txt",
  "glossary_file": "glossary.json"
}
